module(
    name = "cytoskeleton",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "boost.property_tree", version = "1.87.0")
bazel_dep(name = "boost.asio", version = "1.87.0")
bazel_dep(name = "platforms", version = "1.0.0")

# EROS Forge - Unified toolchain and build configuration
# Toolchains are automatically registered by eros_forge module
bazel_dep(name = "eros_forge")
local_path_override(
    module_name = "eros_forge",
    path = "../../forge",
)

# Hedron's Compile Commands Extractor for Bazel
# https://github.com/hedronvision/bazel-compile-commands-extractor
# This tool generates compile_commands.json for clangd language server support
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
archive_override(
    module_name = "hedron_compile_commands",
    urls = ["https://github.com/hedronvision/bazel-compile-commands-extractor/archive/refs/heads/main.zip"],
    strip_prefix = "bazel-compile-commands-extractor-main",
)
