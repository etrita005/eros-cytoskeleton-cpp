package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE", "README.md"])

load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# 编译所有库目标
filegroup(
    name = "libs",
    srcs = [
        "//include/cytoskeleton/concurrent",
        "//include/cytoskeleton/object",
        "//include/cytoskeleton/itc/message_queue",
        "//include/cytoskeleton/module",
    ],
)

# 编译所有示例
filegroup(
    name = "examples",
    srcs = [
        "//examples/concurrent:all",
        "//examples/itc/message_queue:basic_example",
        "//examples/module:loader_example",
    ],
)

# 编译所有目标（库 + 示例）
filegroup(
    name = "all",
    srcs = [
        ":libs",
        ":examples",
    ],
)

# 运行所有测试
test_suite(
    name = "tests",
    tests = [
        "//tests/concurrent:concurrent_test",
        "//tests/object:object_test",
        "//tests/object:singleton_test",
        "//tests/object:lifecycled_object_test",
        "//tests/object:auto_start_lifecycled_object_test",
        "//tests/itc/message_queue:message_queue_test",
        "//tests/module:module_test",
    ],
)

# 测试所有目标（别名）
alias(
    name = "test-all",
    actual = ":tests",
)

# ============================================================
# Debian Package Build Rules
# ============================================================

# Runtime deb package only contains the shared library (stub.cc)
# Using filegroup with output_group to get only the dynamic library
filegroup(
    name = "cytoskeleton_so",
    srcs = ["//include/cytoskeleton/module"],
    output_group = "dynamic_library",
    visibility = ["//visibility:private"],
)

pkg_tar(
    name = "cytoskeleton_data",
    srcs = [":cytoskeleton_so"],
    extension = "tar.gz",
    package_dir = "/opt/eros/lib",
    visibility = ["//visibility:private"],
)

# Generate version file for deb package
genrule(
    name = "deb_version",
    outs = ["deb_version.txt"],
    cmd = "bash -c 'if [ -n \"\"\"$${DEB_VERSION}\"\"\" ]; then echo \"\"\"$${DEB_VERSION}\"\"\"; else echo \"0.1.0\"; fi' > $@",
    visibility = ["//visibility:private"],
)

# amd64 deb package
pkg_deb(
    name = "cytoskeleton_deb_amd64",
    architecture = "amd64",
    built_using = "bazel",
    data = ":cytoskeleton_data",
    description = "Cytoskeleton C++ library - Core framework for EROS",
    homepage = "https://example.com",
    maintainer = "EROS Team <team@example.com>",
    package = "cytoskeleton-cpp",
    version_file = ":deb_version",
    section = "libs",
    priority = "optional",
    visibility = ["//visibility:public"],
)

# arm64 deb package
pkg_deb(
    name = "cytoskeleton_deb_arm64",
    architecture = "arm64",
    built_using = "bazel",
    data = ":cytoskeleton_data",
    description = "Cytoskeleton C++ library - Core framework for EROS",
    homepage = "https://example.com",
    maintainer = "EROS Team <team@example.com>",
    package = "cytoskeleton-cpp",
    version_file = ":deb_version",
    section = "libs",
    priority = "optional",
    visibility = ["//visibility:public"],
)
