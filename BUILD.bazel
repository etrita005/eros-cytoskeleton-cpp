package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE", "README.md"])

load("@eros_forge//bazel:deb.bzl", "pkg_eros_deb", "pkg_eros_tar")

# 编译所有库目标
filegroup(
    name = "libs",
    srcs = [
        "//include/cytoskeleton/concurrent",
        "//include/cytoskeleton/object",
        "//include/cytoskeleton/itc/message_queue",
        "//include/cytoskeleton/module",
    ],
)

# 编译所有示例
filegroup(
    name = "examples",
    srcs = [
        "//examples/concurrent:all",
        "//examples/itc/message_queue:basic_example",
        "//examples/module:loader_example",
    ],
)

# 编译所有目标（库 + 示例）
filegroup(
    name = "all",
    srcs = [
        ":libs",
        ":examples",
    ],
)

# 运行所有测试
test_suite(
    name = "tests",
    tests = [
        "//tests/concurrent:concurrent_test",
        "//tests/object:object_test",
        "//tests/object:singleton_test",
        "//tests/object:lifecycled_object_test",
        "//tests/object:auto_start_lifecycled_object_test",
        "//tests/itc/message_queue:message_queue_test",
        "//tests/module:module_test",
    ],
)

# 测试所有目标（别名）
alias(
    name = "test-all",
    actual = ":tests",
)

# ============================================================
# Debian Package Build Rules
# ============================================================

pkg_eros_tar(
    name = "cytoskeleton_data",
    srcs = ["//include/cytoskeleton/module"],
    output_group = "dynamic_library",
    package_dir = "/opt/eros/lib",
    strip_prefix = "include/cytoskeleton/module",
)

pkg_eros_deb(
    name = "cytoskeleton_deb",
    package_name = "cytoskeleton-cpp",
    data = ":cytoskeleton_data",
    description = "Cytoskeleton C++ library - Core framework for EROS",
    maintainer = "EROS Team <team@example.com>",
    homepage = "https://example.com",
    section = "libs",
    priority = "optional",
    built_using = "bazel",
)
